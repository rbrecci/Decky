{
  "expo": {
    "name": "Decky",
    "slug": "decky",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/Decky-Logo.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "br.senai.decky",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.senai.decky",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/Decky-Logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "lang": "pt-BR",
      "themeColor": "#0A0A0B",
      "favicon": "./assets/Decky-Logo.png"
    },
    "scheme": "decky",
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-camera", {
        "cameraPermission": "Permita que o Decky use a câmera para ler o QR code da sala.",
        "recordAudioAndroid": false,
        "microphonePermission": false,
        "barcodeScannerEnabled": true
      }]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90161be0-e6bf-468a-a32f-23dadd7b779d"
      }
    }
  }
}
